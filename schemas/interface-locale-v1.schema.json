{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actepukc.github.io/Necesse-Lang-Translator/schemas/interface-locale-v1.schema.json",
  "title": "Necesse Translator Interface Locale",
  "type": "object",
  "required": ["format", "version", "code", "name", "nativeName", "messages"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "format": { "const": "necesse-interface-locale" },
    "version": { "const": 1 },
    "code": { "type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" },
    "name": { "type": "string", "minLength": 1 },
    "nativeName": { "type": "string", "minLength": 1 },
    "authors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "updatedAt": { "type": "string", "format": "date" },
    "messages": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string" }
    }
  }
}

{
  "name": "necesse-lang-translator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/generate-locale-assets.mjs && node scripts/build-standalone.mjs",
    "check": "node scripts/check-build.mjs",
    "test": "node --test",
    "validate:glossaries": "node scripts/validate-glossaries.mjs",
    "validate:interface-locales": "node scripts/validate-interface-locales.mjs",
    "verify": "npm test && npm run validate:locales && npm run validate:interface-locales && npm run validate:glossaries && npm run build && npm run check",
    "dev": "node scripts/serve.mjs src",
    "preview": "npm run build && node scripts/serve.mjs dist",
    "validate:locales": "node scripts/validate-locales.mjs"
  }
}
